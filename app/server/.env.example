# порт api
PORT=3001
# адреса фронтенда через запятую для cors
CORS_ORIGIN=http://localhost:3000

# подключение к postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=vetsoft
DB_PASSWORD=vetsoft
DB_NAME=vetsoft
# true создает и обновляет таблицы автоматически, на продакшене лучше false и миграции
DB_SYNCHRONIZE=true

# jwt
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# демо-данные и служебные аккаунты при первом запуске
SEED_ON_START=true
SEED_DEMO_DATA=true
SEED_STAFF_PASSWORD=ChangeMe123!

# клиника
CLINIC_TIMEZONE=Europe/Moscow
CLINIC_PHONE=+7 999 999 99 99
CLINIC_EMAIL=mail@vetsoft.local
CLINIC_ADDRESS=г. Великий Новгород, ул. Кочетова, дом 16/46

# почта для напоминаний, если SMTP_HOST пуст то письма только пишутся в лог
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=VetSoft <no-reply@vetsoft.local>
