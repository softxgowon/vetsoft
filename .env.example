# используется docker-compose.yml, для запуска сервисов по отдельности смотрите backend/.env.example и frontend/.env.example
DB_USER=vetsoft
DB_PASSWORD=vetsoft
DB_NAME=vetsoft
DB_SYNCHRONIZE=true

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

SEED_ON_START=true
SEED_DEMO_DATA=true
SEED_STAFF_PASSWORD=ChangeMe123!

CLINIC_TIMEZONE=Europe/Moscow
CLINIC_PHONE=+7 999 999 99 99
CLINIC_EMAIL=mail@vetsoft.local
CLINIC_ADDRESS=г. Великий Новгород, ул. Кочетова, дом 16/46

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=VetSoft <no-reply@vetsoft.local>

# порт, на котором сайт будет доступен на хосте (http://localhost:8080)
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080
